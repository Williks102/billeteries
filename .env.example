APP_NAME="Billetterie"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=billetterie
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# En production (HTTPS) : SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Paiement manuel (confirmé par l'admin) : durée de réservation en minutes (48 h par défaut)
MANUAL_RESERVATION_MINUTES=2880
# Instructions affichées à l'acheteur (génériques par défaut ; ne jamais commiter de vrais numéros de compte)
MANUAL_BANK_NAME=
MANUAL_BANK_ACCOUNT_HOLDER=
MANUAL_BANK_IBAN=
MANUAL_MOBILE_MONEY_NUMBER=
MANUAL_MOBILE_MONEY_HOLDER=
MANUAL_CASH_LOCATION=

# Telescope : désactivé par défaut (activer uniquement en local)
TELESCOPE_ENABLED=false

# Seeders de démo (hors production). Vide = mot de passe aléatoire
SEED_ADMIN_PASSWORD=
SEED_PROMOTEUR_PASSWORD=
SEED_ACHETEUR_PASSWORD=
