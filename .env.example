APP_NAME="Billetterie"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=billetterie
# DB_USERNAME=
# DB_PASSWORD=
# TLS MySQL/TiDB (vide = désactivé, connexions locales inchangées). TiDB Cloud exige TLS (port 4000) :
# DB_SSL_CA = fichier des certificats racine (Debian/Docker : /etc/ssl/certs/ca-certificates.crt)
# DB_SSL_VERIFY = true pour vérifier le certificat du serveur
DB_SSL_CA=
DB_SSL_VERIFY=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# En production (HTTPS), décommenter :
# SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Paiement manuel (confirmé par l'admin) : durée de réservation en minutes (48 h par défaut)
MANUAL_RESERVATION_MINUTES=2880
# Réservation pour un invité non vérifié (minutes, 24 h par défaut ; 48 h pour un utilisateur connecté)
GUEST_MANUAL_RESERVATION_MINUTES=1440
# Commandes pending simultanées max par email / compte, et commandes invité max par IP sur la fenêtre invité
MAX_PENDING_ORDERS=3
MAX_PENDING_ORDERS_PER_IP=10
# Plafond de billets en attente par événement = clamp(ceil(PENDING_RATIO x capacité), PENDING_MIN, MAX_PENDING_TICKETS_PER_EVENT), compté sous verrou
PENDING_RATIO=0.3
PENDING_MIN=10
MAX_PENDING_TICKETS_PER_EVENT=200
# Quota de billets en attente par acteur (email normalisé / compte) et par IP (fenêtre invité)
MAX_PENDING_TICKETS_PER_BUYER=10
MAX_PENDING_TICKETS_PER_IP=20
# Throttle de l'inscription (tentatives/minute/IP)
REGISTER_THROTTLE_PER_MINUTE=5
# Le plafond IP s'applique aux invités ET aux comptes de moins de 24 h
# Throttle des POST checkout (par minute ; clé = IP, ou id utilisateur pour un connecté) : 429 au-delà
CHECKOUT_THROTTLE_PER_MINUTE=10
# Throttle des routes publiques verify-ticket (par minute et par IP)
VERIFY_TICKET_THROTTLE_PER_MINUTE=60
# Instructions affichées à l'acheteur (génériques par défaut ; ne jamais commiter de vrais numéros de compte)
MANUAL_BANK_NAME=
MANUAL_BANK_ACCOUNT_HOLDER=
MANUAL_BANK_IBAN=
MANUAL_MOBILE_MONEY_NUMBER=
MANUAL_MOBILE_MONEY_HOLDER=
MANUAL_CASH_LOCATION=

# Telescope : désactivé par défaut (activer uniquement en local)
TELESCOPE_ENABLED=false

# Seeders de démo (hors production). Vide = mot de passe aléatoire
SEED_ADMIN_PASSWORD=
SEED_PROMOTEUR_PASSWORD=
SEED_ACHETEUR_PASSWORD=

# Proxys de confiance (IP/CIDR séparés par des virgules, ou * si le proxy réécrit toujours X-Forwarded-For).
# ATTENTION : derrière Cloudflare/Nginx/hébergeur, sans cela toutes les requêtes ont la même IP
# (celle du proxy) et le throttle / plafond par IP devient GLOBAL pour tout le site.
# Vide = aucun proxy de confiance (défaut, à garder en local). Ne jamais mettre * si le serveur est joignable
# sans passer par le proxy (l'en-tête X-Forwarded-For serait falsifiable).
# Avec `config:cache`, définir ces variables dans l'environnement réel (.env non relu).
TRUSTED_PROXIES=
# Optionnel : forwarded (RFC 7239) ou aws-elb ; vide = X-Forwarded-For/Host/Port/Proto
TRUSTED_PROXY_HEADERS=

# Taux de commission par défaut de la plateforme, en % du prix des billets (défaut 6).
# Les taux promoteur / catégorie (table commission_settings) restent prioritaires.
DEFAULT_COMMISSION_RATE=6

# Démo (Render + TiDB, voir docs/deploiement-render.md) : au démarrage du conteneur, si DEMO_SEED=true ET si la table
# users est vide, php artisan demo:seed crée catégories, commissions et un compte admin. ADMIN_PASSWORD : 12 caractères
# minimum, saisi uniquement dans l'environnement réel (jamais dans le dépôt), sinon aucun compte n'est créé.
DEMO_SEED=false
ADMIN_EMAIL=
ADMIN_PASSWORD=

# MODE DÉMO : confirme AUTOMATIQUEMENT chaque commande à la fin du checkout (référence DEMO-AUTO, billets émis et QR visibles).
# DÉMO UNIQUEMENT : les billets deviennent gratuits. Laisser à false (défaut) partout ailleurs ; un bandeau « MODE DÉMO » doit s'afficher.
DEMO_AUTO_CONFIRM_PAYMENTS=false
# En APP_ENV=production, le mode démo exige AUSSI DEMO_MODE_ACKNOWLEDGED=true (sinon ignoré + log critique).
DEMO_MODE_ACKNOWLEDGED=false
